<section class="tab flexcol {{tab.cssClass}}" data-tab="skills" data-group="primary">
	<div class="skills-details">
		<div class="skills-content">
			{{#each system.skills as |skill key|}}
				<div class="skill flexrow flex-group-center degree-{{skill.degree.label}} {{#if (lookup (lookup @root.conditionDisplay.skills key) 'affected')}}condition-affected{{/if}}">

					{{! NOME DA PERÍCIA }}
					{{#if skill.conditions.open}}
						<input
							type="text"
							name="system.skills.{{key}}.name"
							value="{{skill.name}}"
							class="resource-label flexlarge align-center {{#if (lookup (lookup @root.conditionDisplay.skills key) 'affected')}}condition-affected{{/if}}"
							data-type="String"
							placeholder="{{localize 'op.skill.freeSkill'}}"
						/>
						{{opConditionPenalty @root.conditionDisplay "skills" key}}
						<i
							class="fas fa-dice {{key}} rollable rollFreeSkill compendium-event-contextmenu"
							data-action="onRollSkillCheck"
							data-roll="{{skill.formula}}"
							data-label="{{skill.label}}"
							data-key="{{key}}"
						></i>
					{{else}}
						<label
							for="system.skills.{{key}}.value"
							data-action="onRollSkillCheck"
							class="resource-label rollable flexlarge align-left skill-name compendium-event-contextmenu {{#if (lookup (lookup @root.conditionDisplay.skills key) 'affected')}}condition-affected{{/if}}"
							data-label="{{skill.label}}"
							data-key="{{key}}"
							data-rollType="skill"
						>{{skill.label}} {{opConditionPenalty @root.conditionDisplay "skills" key}}</label>
					{{/if}}

					{{! ATRIBUTO }}
					<label class="flex0 p-side-10">
						<strong>{{toUpperCase (localize (concat "op." (lookup skill.attr 0) "Abv"))}}</strong>
					</label>

					{{! TREINO }}
					<select name="system.skills.{{key}}.degree.label" data-dtype="String">
						{{selectOptions @root.optionDegree selected=skill.degree.label localize=true}}
					</select>

					{{! NOVO: VALOR TOTAL (Calculado no actor-sheet.mjs) }}
					<div class="flex0" style="margin: 0 5px; display: flex; justify-content: center;">
						<input
							type="text"
							value="{{numberFormat (lookup @root.skillTotals key) decimals=0 sign=true}}"
							readonly
							style="width: 40px; text-align: center; border: none; font-weight: bold; background: rgba(0,0,0,0.05);"
							title="{{localize 'op.totalSkillTooltip'}}"
						/>
					</div>

					{{! BÔNUS EDITÁVEL }}
					<input
						type="text"
						name="system.skills.{{key}}.mod"
						value="{{skill.mod}}"
						data-dtype="Number"
						class="modifier"
						placeholder="0"
					/>

					{{! DADOS EXTRAS/PENALIDADE (±d20) }}
					<div class="flex0 dice-mod-wrapper" title="{{localize 'op.diceModTooltip'}}">
						<button
							type="button"
							class="dice-mod-btn dice-mod-minus"
							data-action="diceModDecrement"
							data-skill="{{key}}"
							tabindex="-1"
						>−</button>
						<span class="dice-mod-value {{#if skill.diceMod}}{{#if (gt skill.diceMod 0)}}positive{{else}}negative{{/if}}{{/if}}">
							<i class="fas fa-dice-d20 dice-mod-icon"></i>{{#if skill.diceMod}}{{numberFormat skill.diceMod decimals=0 sign=true}}{{else}}0{{/if}}
						</span>
						<button
							type="button"
							class="dice-mod-btn dice-mod-plus"
							data-action="diceModIncrement"
							data-skill="{{key}}"
							tabindex="-1"
						>+</button>
					</div>

				</div>
			{{/each}}
		</div>
	</div>
</section>